{
  "name": "meme-bot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "prepare": "effect-language-service patch"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "@discordjs/ws": "^2.0.4",
    "@effect/platform-node": "4.1.4",
    "@effect/sql-pg": "4.1.4",
    "discord-api-types": "^0.38.57",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.1.4",
    "fast-xml-parser": "^5.12.0"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.5",
    "@effect/vitest": "4.1.4",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "1.0.0-rc.5",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
