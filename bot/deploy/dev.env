# ⚔️ WoW: Forever news (news.ts)
NEWS_CHANNEL_ID=1570055780978266122
# ⚔️ plan 06: the subreddits the news reads (each judged against its own usual level) and its
# daily cap. The write-ups come from an outside writer (a scheduled Claude agent) through
# GET /news/queue and POST /news/article, behind NEWS_WRITER_KEY (a secret: secrets.env on the
# server; unset, both routes are 404). Who they're for is NEWS_AUDIENCE: its default is in config.ts
# (a value with spaces stays out of this file).
NEWS_SUBREDDITS=wowforever,classicwow,wow
NEWS_DAILY_POSTS=3
# ⚔️ plan 06: the backtest's day queues are open to the writer (GET /news/queue?day=…) and its
# write-ups for them are posted to the news channel, marked as backtests; only the test bot sets this.
NEWS_BACKTEST_POST=1
# 🔊 the bot speaks in voice (botvoice.ts) until the 🔇 toggle on the HQ panel says otherwise
BOT_VOICE=on
